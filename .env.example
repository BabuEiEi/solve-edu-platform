# Copy to .env.local and fill in. NEVER commit real values.
# Local:  run `npx supabase start` and copy "API URL" + "Publishable key".
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Server-only secrets (NOT prefixed with VITE_, never shipped to the browser).
# Used only by supabase/config.toml env() substitution when Google OAuth is enabled.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Google Drive copy of task files: needs a Google Workspace Shared Drive (docs/DEPLOY_PHASE3B.md).
# Off by default; the reviewer's page offers the .zip download instead. Local E2E sets it to true.
# VITE_DRIVE_EXPORT=true
