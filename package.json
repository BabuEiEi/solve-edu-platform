{
  "name": "solve-edu-platform",
  "version": "0.1.0",
  "description": "SolveEdu Integrated Platform — teacher development, assessment and 6Es supervision (Phase 1 foundation)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:reset:pg": "scripts/db-local/reset.sh",
    "db:test:pg": "scripts/db-local/test.sh",
    "test:integration": "scripts/supabase-local/test-integration.sh",
    "test:e2e": "npx supabase db reset --local && playwright test --project=chromium",
    "test:e2e:webkit": "npx supabase db reset --local && playwright test --project=webkit-iphone",
    "check": "npm run lint && npm run test && npm run build"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@supabase/postgrest-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "dompurify": "^3.4.17"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
